# Local canonical storage. Independent of Neo4j/Qdrant. Never use admin for runtime writes.
STORAGE_HOST=127.0.0.1
STORAGE_PORT=5432
STORAGE_DATABASE=email_assistant
STORAGE_RUNTIME_USER=email_assistant_runtime
STORAGE_RUNTIME_PASSWORD=
STORAGE_ADMIN_USER=email_assistant
STORAGE_ADMIN_PASSWORD=
STORAGE_ARTIFACT_ROOT=
